generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==========================================
// CORE iVALUE COE INFRASTRUCTURE MODELS
// ==========================================

model ContactInquiry {
  id           String   @id @default(cuid())
  fullName     String
  workEmail    String
  company      String
  title        String?
  interestArea String?
  message      String
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([workEmail])
  @@index([status])
}

model PartnerApplication {
  id          String             @id @default(cuid())
  companyName String
  partnerTier String             @default("standard")
  contactName String
  workEmail   String
  phone       String?
  region      String?
  status      String             @default("pending")
  createdAt   DateTime           @default(now())
  handshakes  PartnerHandshake[]

  @@index([workEmail])
  @@index([status])
}

model PartnerHandshake {
  id           String              @id @default(cuid())
  partnerId    String
  handshakeKey String              @unique
  verifiedAt   DateTime?
  createdAt    DateTime            @default(now())
  partner      PartnerApplication? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// ==========================================
// APPLICATION & CONTENT PLATFORM MODELS
// ==========================================

model userlist {
  id             Int    @id @default(autoincrement())
  email          String
  name           String
  userType       String
  provider       String @default("google")
  profileImage   String
  accessToken    String
  accessTillDate String

  @@map("userlist")
}

model approvedrequest {
  id                       Int    @id @default(autoincrement())
  requesteduserlistEmail   String
  contentID                String
  contentIdKey             String
  orchestrationID          String
  orchestrationVMGroupName String
}

model category {
  id              Int    @id @default(autoincrement())
  category        String
  subCategory     String
  subCategoryFull String
}

model cdnvideos {
  id               Int      @id @default(autoincrement())
  contentID        String
  contentIdKey     String
  cdnUrl           String
  createdAt        DateTime @default(now())
  videoName        String
  videoDescription String
}

model cloudconsoleuser {
  id                Int       @id @default(autoincrement())
  email             String    @unique(map: "email")
  otp               String?
  is_verified       String?   @default("0")
  password_hash     String?
  card_holder_name  String?
  card_last_four    String?
  card_expiry_month String?
  card_expiry_year  String?
  payment_status    String
  first_name        String?
  last_name         String?
  phone             String?
  organization_name String?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @default(now())
}

model content {
  id                Int     @id @default(autoincrement())
  idKey             String
  oem               String
  oemImage          String
  head              String
  headDetails       String
  overView          String
  howToAccess       String
  supportContent    String
  accessSteps       String?
  accessCredentials String?
  comingSoon        String  @default("No")
  contentStatus     String  @default("draft")
}

model contentcategory {
  id           Int    @id @default(autoincrement())
  contentID    String
  contentIdKey String
  category     String
  subCategory  String
}

model contentplaybooks {
  id           Int      @id @default(autoincrement())
  contentID    String
  contentIdKey String
  fileName     String
  createdAt    DateTime @default(now())
}

model contentresources {
  id           Int    @id @default(autoincrement())
  contentID    String
  contentIdKey String
  fileName     String
}

model deletedrequesteduser {
  id               Int       @id @default(autoincrement())
  userName         String
  userEmail        String
  organizationName String
  countryName      String
  timezone         String
  comments         String
  contentID        String
  contentIdKey     String
  requestedDate    String
  startDate        String
  endDate          String
  userAccessKeys   String
  otp              String
  otpTime          String
  status           String
  adminComment     String
  deletedAt        DateTime?
  deletedBy        String?
}

model knowledge_documents {
  id          Int       @id @default(autoincrement())
  file_name   String
  object_name String
  mime_type   String?
  file_size   BigInt
  status      String?   @default("Pending")
  uploaded_by String
  created_at  DateTime? @default(now())
}

model oem {
  id      Int    @id @default(autoincrement())
  oemName String
  logo    String
}

model orchestration {
  id                       Int    @id @default(autoincrement())
  contentID                String
  contentIdKey             String
  orchestration            String
  orchestrationVMGroupName String
}

model orchestrationvmgroup {
  id                       Int    @id @default(autoincrement())
  orchestrationID          String
  orchestrationVMGroupName String
  vmID                     String
  comments                 String
}

model product_access {
  id           Int       @id @default(autoincrement())
  userId       Int
  contentId    Int
  accessStatus String    @default("active")
  grantedBy    Int?
  grantedDate  DateTime  @default(now())
  expiryDate   DateTime?
  createdDate  DateTime  @default(now())
  updatedDate  DateTime  @default(now())

  @@unique([userId, contentId], map: "product_access_unique_user_content")
  @@index([accessStatus], map: "product_access_idx_accessStatus")
  @@index([contentId], map: "product_access_idx_contentId")
  @@index([userId], map: "product_access_idx_userId")
}

model publicfile {
  id           Int    @id @default(autoincrement())
  fileName     String
  contentID    String
  contentIdKey String
}

model requesteduserlist {
  id               Int    @id @default(autoincrement())
  userName         String
  userEmail        String
  organizationName String
  countryName      String
  timezone         String
  comments         String
  contentID        String
  contentIdKey     String
  requestedDate    String
  startDate        String
  endDate          String
  userAccessKeys   String
  otp              String
  otpTime          String
  status           String
  adminComment     String
}

model rssfeeds {
  id    Int    @id @default(autoincrement())
  oem   String
  image String
  head  String
  url   String
}

model user_content_access {
  id          Int      @id @default(autoincrement())
  userId      Int
  contentId   Int
  idKey       String
  status      String   @default("active")
  grantedBy   Int
  grantedDate DateTime @default(now())
  updatedDate DateTime @default(now())

  @@unique([userId, contentId], map: "user_content_access_unique_user_content")
  @@index([contentId], map: "user_content_access_idx_contentId")
  @@index([idKey], map: "user_content_access_idx_idKey")
  @@index([status], map: "user_content_access_idx_status")
  @@index([userId], map: "user_content_access_idx_userId")
}

model visitorlogs {
  id             Int      @id @default(autoincrement())
  contentId      String
  contentKey     String
  UserOS         String
  UserBrowser    String
  UserIP         String
  UserCity       String
  UserRegionName String
  UserCountry    String
  UserDevice     String
  time           DateTime @default(now())
}

model ytvideos {
  id           Int     @id @default(autoincrement())
  contentID    String
  contentIdKey String
  ytCode       String
  ytType       String? @default("single")
}

// ==========================================
// NEXTAUTH & JWT SESSION MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          String?   @default("user")
  provider      String?   @default("google")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
